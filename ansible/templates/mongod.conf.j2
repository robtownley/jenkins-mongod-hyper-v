# Managed by Ansible: MongoDB 8.0 lab
storage:
  dbPath: /var/lib/mongo
  wiredTiger:
    engineConfig:
      cacheSizeGB: 1
systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log
net:
  port: 27017
  bindIp: "127.0.0.1,{{ private_ip }}"
replication:
  replSetName: rs0
  oplogSizeMB: 1024
security:
  keyFile: /var/lib/mongo/internal-auth/keyfile
  authorization: enabled
processManagement:
  timeZoneInfo: /usr/share/zoneinfo
